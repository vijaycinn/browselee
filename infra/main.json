          },
          "foundryEndpoint": {
            "value": "[parameters('foundryEndpoint')]"
          },
          "image": {
            "value": "[parameters('image')]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.40.2.10011",
              "templateHash": "16935087781103542977"
            }
          },
          "parameters": {
            "env": {
              "type": "string"
            },
            "location": {
              "type": "string"
            },
            "uamiId": {
              "type": "string",
              "metadata": {
                "description": "Resource ID of the User-Assigned Managed Identity."
              }
            },
            "uamiClientId": {
              "type": "string",
              "metadata": {
                "description": "Client ID of the UAMI — injected as AZURE_CLIENT_ID env var."
              }
            },
            "uamiPrincipalId": {
              "type": "string",
              "metadata": {
                "description": "Principal ID of the UAMI — used for AcrPull role assignment."
              }
            },
            "foundryEndpoint": {
              "type": "string",
              "metadata": {
                "description": "Foundry endpoint URL for the FOUNDRY_ENDPOINT env var."
              }
            },
            "image": {
              "type": "string",
              "defaultValue": "mcr.microsoft.com/k8se/quickstart:latest",
              "metadata": {
                "description": "Container image. Defaults to a harmless quickstart placeholder."
              }
            }
          },
          "variables": {
            "acrName": "[format('browseleeacr{0}', uniqueString(resourceGroup().id))]",
            "acrPullRoleId": "7f951dda-4ed3-4680-a7ca-43fe172d538d"
          },
          "resources": [
            {
              "type": "Microsoft.OperationalInsights/workspaces",
              "apiVersion": "2022-10-01",
              "name": "[format('browselee-{0}-logs', parameters('env'))]",
              "location": "[parameters('location')]",
              "properties": {
                "sku": {
                  "name": "PerGB2018"
                },
                "retentionInDays": 30
              }
            },
            {
              "type": "Microsoft.ContainerRegistry/registries",
              "apiVersion": "2023-07-01",
              "name": "[variables('acrName')]",
              "location": "[parameters('location')]",
              "sku": {
