            },
            "uamiClientId": {
              "type": "string",
              "value": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('browselee-{0}-uami', parameters('env'))), '2023-01-31').clientId]"
            },
            "uamiPrincipalId": {
              "type": "string",
              "value": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('browselee-{0}-uami', parameters('env'))), '2023-01-31').principalId]"
            }
          }
