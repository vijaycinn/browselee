      "value": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, variables('rgName')), 'Microsoft.Resources/deployments', 'aca'), '2025-04-01').outputs.acaName.value]"
    },
    "acaRg": {
      "type": "string",
