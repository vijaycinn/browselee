    }
  },
  "parameters": {
    "env": {
      "type": "string",
      "defaultValue": "dev",
      "metadata": {
        "description": "Deployment environment tag (dev / staging / prod)."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "eastus2",
