      "value": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, variables('rgName')), 'Microsoft.Resources/deployments', 'identity'), '2025-04-01').outputs.uamiClientId.value]"
    },
    "uamiPrincipalId": {
