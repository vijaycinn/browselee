                    "sharedKey": "[listKeys(resourceId('Microsoft.OperationalInsights/workspaces', format('browselee-{0}-logs', parameters('env'))), '2022-10-01').primarySharedKey]"
                  }
                }
              },
              "dependsOn": [
                "[resourceId('Microsoft.OperationalInsights/workspaces', format('browselee-{0}-logs', parameters('env')))]"
              ]
            },
            {
              "type": "Microsoft.App/containerApps",
              "apiVersion": "2023-05-01",
              "name": "[format('browselee-{0}-api', parameters('env'))]",
              "location": "[parameters('location')]",
              "identity": {
                "type": "UserAssigned",
                "userAssignedIdentities": {
                  "[format('{0}', parameters('uamiId'))]": {}
                }
              },
              "properties": {
                "environmentId": "[resourceId('Microsoft.App/managedEnvironments', format('browselee-{0}-env', parameters('env')))]",
                "configuration": {
                  "ingress": {
                    "external": true,
                    "targetPort": 8080,
                    "allowInsecure": false
                  },
                  "registries": [
