        "description": "Existing Azure AI Foundry account name."
      }
    },
    "foundryEndpoint": {
      "type": "string",
      "defaultValue": "https://smec-poc-vcinn-resource.services.ai.azure.com",
      "metadata": {
        "description": "Foundry endpoint URL injected into the container as an env var."
      }
    },
    "image": {
      "type": "string",
      "defaultValue": "mcr.microsoft.com/k8se/quickstart:latest",
      "metadata": {
        "description": "Container image to deploy. Override in CI after the first push to ACR."
      }
    }
  },
  "variables": {
    "rgName": "[format('rg-browselee-{0}', parameters('env'))]"
  },
  "resources": [
